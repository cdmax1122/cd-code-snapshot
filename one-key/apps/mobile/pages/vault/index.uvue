<template>
  <view class="page vault-page">
    <view class="header">
      <view>
        <text class="eyebrow">本地保险箱</text>
        <text class="page-title">全部账户</text>
      </view>
      <button class="lock-button" @click="lock">锁定</button>
    </view>

    <input class="field search" v-model="query" placeholder="搜索名称、用户名、域名或标签" @input="refresh" />

    <view class="quick-actions">
      <view class="quick-item" @click="openGenerator"><text class="quick-title">生成密码</text><text class="muted">安全随机</text></view>
      <view class="quick-item" @click="openSecurity"><text class="quick-title">安全状态</text><text class="muted">本地透明</text></view>
      <view class="quick-item" @click="openSettings"><text class="quick-title">设置</text><text class="muted">锁定与备份</text></view>
    </view>

    <scroll-view class="account-list" scroll-y="true">
      <view v-if="accounts.length === 0" class="empty-state">
        <text class="empty-title">{{ query.length > 0 ? '没有匹配账户' : '保险箱还是空的' }}</text>
        <text class="subtitle">{{ query.length > 0 ? '换个关键词试试。' : '添加第一个账户，密码会立即写入加密文件。' }}</text>
      </view>
      <view class="account-row" v-for="account in accounts" :key="account.id" @click="openAccount(account.id)">
        <view class="avatar"><text class="avatar-text">{{ initial(account.title) }}</text></view>
        <view class="account-main">
          <text class="account-title">{{ account.title }}</text>
          <text class="account-identity">{{ identity(account) }}</text>
          <text class="domain">{{ domain(account) }}</text>
        </view>
        <text class="credential">Password{{ account.credentials.passkeys?.length ? ' · Passkey' : '' }}</text>
      </view>
      <view class="bottom-space"></view>
    </scroll-view>

    <button class="add-button" @click="addAccount">＋ 添加账户</button>
  </view>
</template>

<script lang="uts">
import { AccountEntry } from '@/core/domain/models.uts'
import { accountService } from '../../services/account-service.uts'
import { vaultService } from '../../services/native-vault.uts'
import { sessionStore } from '../../stores/session.uts'

export default {
  data() {
    return { query: '', accounts: [] as AccountEntry[] }
  },
  onShow() {
    if (!vaultService.unlocked()) {
      uni.reLaunch({ url: '/pages/unlock/index' })
      return
    }
    sessionStore.recordActivity()
    this.refresh()
  },
  methods: {
    refresh() { this.accounts = accountService.list(this.query) },
    initial(title: string): string { return title.length > 0 ? title.substring(0, 1).toUpperCase() : '?' },
    identity(account: AccountEntry): string {
      const email = account.identity?.email
      if (email != null && email.length > 0) return email
      const username = account.identity?.username
      if (username != null && username.length > 0) return username
      return '未填写用户名'
    },
    domain(account: AccountEntry): string {
      if (account.urls.length === 0) return '未填写网站'
      return account.urls[0].replace('https://', '').replace('http://', '').split('/')[0]
    },
    openAccount(id: string) {
      sessionStore.recordActivity()
      uni.navigateTo({ url: `/pages/account/detail?id=${encodeURIComponent(id)}` })
    },
    addAccount() { uni.navigateTo({ url: '/pages/account/edit' }) },
    openGenerator() { uni.navigateTo({ url: '/pages/generator/index' }) },
    openSecurity() { uni.navigateTo({ url: '/pages/security/index' }) },
    openSettings() { uni.navigateTo({ url: '/pages/settings/index' }) },
    lock() { sessionStore.lockAndReturn() }
  }
}
</script>

<style>
.vault-page { padding-bottom: 20px; }
.header { margin-top: 28px; flex-direction: row; align-items: flex-end; justify-content: space-between; }
.eyebrow { color: #176B4D; font-size: 13px; font-weight: 650; margin-bottom: 4px; }
.lock-button { margin: 0; height: 38px; padding: 0 15px; color: #536159; background-color: #FFFFFF; border: 1px solid #DCE2DE; border-radius: 9px; font-size: 14px; }
.search { margin-top: 20px; }
.quick-actions { margin-top: 14px; flex-direction: row; }
.quick-item { flex: 1; padding: 13px 11px; border-radius: 11px; background-color: #FFFFFF; border: 1px solid #E3E8E4; }
.quick-item + .quick-item { margin-left: 8px; }
.quick-title { color: #243129; font-size: 14px; font-weight: 600; margin-bottom: 3px; }
.account-list { flex: 1; margin-top: 16px; }
.account-row { min-height: 80px; padding: 14px 4px; flex-direction: row; align-items: center; border-bottom: 1px solid #E1E6E2; }
.avatar { width: 44px; height: 44px; border-radius: 12px; background-color: #E7F2ED; align-items: center; justify-content: center; }
.avatar-text { color: #176B4D; font-size: 18px; font-weight: 700; }
.account-main { flex: 1; margin-left: 12px; }
.account-title { font-size: 16px; font-weight: 650; color: #1E2A23; }
.account-identity { margin-top: 3px; font-size: 13px; color: #5B685F; }
.domain { margin-top: 2px; font-size: 12px; color: #879088; }
.credential { max-width: 82px; text-align: right; font-size: 11px; color: #176B4D; }
.empty-state { margin-top: 58px; padding: 28px; align-items: center; }
.empty-title { font-size: 18px; font-weight: 650; color: #344239; }
.bottom-space { height: 90px; }
.add-button { position: absolute; right: 20px; bottom: 24px; height: 48px; padding: 0 20px; border-radius: 24px; color: #FFFFFF; background-color: #176B4D; font-size: 15px; font-weight: 600; }
</style>
