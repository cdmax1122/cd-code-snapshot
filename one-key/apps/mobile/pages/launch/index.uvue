.launch-page { align-items: center; justify-content: center; }
.mark { width: 64px; height: 64px; border-radius: 18px; background-color: #176B4D; align-items: center; justify-content: center; }
.mark-text { color: #FFFFFF; font-size: 28px; font-weight: 700; }
.brand { margin-top: 18px; font-size: 22px; font-weight: 700; }
.launch-note { margin-top: 10px; }
</style>

