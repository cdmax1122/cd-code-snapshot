export type StrengthLevel = 'weak' | 'fair' | 'strong' | 'veryStrong'
export type PasswordStrength = { level: StrengthLevel; score: number; reasons: string[]; suggestions: string[] }

const COMMON = ['password', 'p@ssw0rd', '123456', '12345678', 'qwerty', 'admin', 'letmein', 'welcome']
const SEQUENCES = ['0123456789', 'abcdefghijklmnopqrstuvwxyz', 'qwertyuiop', 'asdfghjkl']

export function strengthLabel(level: StrengthLevel): string {
  if (level === 'weak') return '弱'
  if (level === 'fair') return '一般'
  if (level === 'strong') return '强'
  return '很强'
}

export function evaluatePassword(password: string): PasswordStrength {
  const reasons: string[] = []
  const suggestions: string[] = []
  const lower = password.toLowerCase()
  let score = 0
  if (password.length >= 20) score += 3
  else if (password.length >= 16) score += 2
  else if (password.length >= 10) score += 1
  else { reasons.push('密码长度较短'); suggestions.push('建议使用至少 16 位密码') }
  let groups = 0
  if (/[a-z]/.test(password)) groups++
  if (/[A-Z]/.test(password)) groups++
  if (/[0-9]/.test(password)) groups++
  if (/[^a-zA-Z0-9]/.test(password)) groups++
  if (groups >= 3) score += 1
  if (COMMON.some((value) => lower.indexOf(value) >= 0)) { score -= 3; reasons.push('包含常见密码或其变形'); suggestions.push('避免常见单词、名称和简单替换') }
  if (SEQUENCES.some((sequence) => sequence.indexOf(lower) >= 0 || sequence.split('').reverse().join('').indexOf(lower) >= 0)) { score -= 2; reasons.push('包含连续字符或键盘序列'); suggestions.push('避免连续数字、字母和键盘路径') }
  if (/(.)\1{2,}/.test(password) || /(.{2,4})\1{1,}/.test(password)) { score -= 2; reasons.push('包含重复模式'); suggestions.push('减少重复字符或重复片段') }
  if (/(19|20)\d{2}/.test(password) || /\d{6,8}/.test(password)) { score -= 1; reasons.push('可能包含日期或长数字'); suggestions.push('不要使用生日、年份或手机号片段') }
  score = Math.max(0, Math.min(4, score))
  const level: StrengthLevel = score <= 1 ? 'weak' : score == 2 ? 'fair' : score == 3 ? 'strong' : 'veryStrong'
  if (suggestions.length == 0 && level !== 'veryStrong') suggestions.push('增加长度通常比堆叠符号更有效')
  if (reasons.length == 0) reasons.push('未发现明显的常见模式')
  return { level, score, reasons, suggestions }
}
