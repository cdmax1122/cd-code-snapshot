export type PasswordGenerateOptions = {
  length: number
  uppercase: boolean
  lowercase: boolean
  numbers: boolean
  symbols: boolean
  excludeSimilar: boolean
  customSymbols: string
  requireEachType: boolean
}

export interface SecureRandomProvider { nextBytes(length: number): number[] }

const UPPERCASE = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
const LOWERCASE = 'abcdefghijklmnopqrstuvwxyz'
const NUMBERS = '0123456789'
const DEFAULT_SYMBOLS = '!@#$%^&*()-_=+[]{};:,.?'
const SIMILAR = 'O0Il1'

function withoutSimilar(value: string): string {
  return value.split('').filter((char) => SIMILAR.indexOf(char) < 0).join('')
}

function secureIndex(size: number, random: SecureRandomProvider): number {
  const limit = 256 - (256 % size)
  while (true) {
    const value = random.nextBytes(1)[0]
    if (value < limit) return value % size
  }
}

function pick(characters: string, random: SecureRandomProvider): string {
  return characters.charAt(secureIndex(characters.length, random))
}

export function defaultGenerateOptions(): PasswordGenerateOptions {
  return { length: 20, uppercase: true, lowercase: true, numbers: true, symbols: true, excludeSimilar: false, customSymbols: DEFAULT_SYMBOLS, requireEachType: true }
}

export function generatePassword(options: PasswordGenerateOptions, random: SecureRandomProvider): string {
  const groups: string[] = []
  if (options.uppercase) groups.push(UPPERCASE)
  if (options.lowercase) groups.push(LOWERCASE)
  if (options.numbers) groups.push(NUMBERS)
  if (options.symbols) groups.push(options.customSymbols.length > 0 ? options.customSymbols : DEFAULT_SYMBOLS)
  if (groups.length == 0) throw new Error('至少选择一种字符类型')
  if (options.requireEachType && options.length < groups.length) throw new Error('密码长度不足以包含全部字符类型')
  const usableGroups = options.excludeSimilar ? groups.map((group: string) => withoutSimilar(group)) : groups
  if (usableGroups.some((group) => group.length == 0)) throw new Error('字符集不能为空')
  const pool = usableGroups.join('')
  const result: string[] = []
  if (options.requireEachType) {
    usableGroups.forEach((group: string) => {
      result.push(pick(group, random))
    })
  }
  while (result.length < options.length) result.push(pick(pool, random))
  for (let index = result.length - 1; index > 0; index--) {
    const target = secureIndex(index + 1, random)
    const value = result[index]
    result[index] = result[target]
    result[target] = value
  }
  return result.join('')
}

export function generatedEntropyBits(options: PasswordGenerateOptions): number {
  const groups: string[] = []
  if (options.uppercase) groups.push(UPPERCASE)
  if (options.lowercase) groups.push(LOWERCASE)
  if (options.numbers) groups.push(NUMBERS)
  if (options.symbols) groups.push(options.customSymbols.length > 0 ? options.customSymbols : DEFAULT_SYMBOLS)
  const normalizedGroups = options.excludeSimilar ? groups.map((group: string) => withoutSimilar(group)) : groups
  const size = Math.max(1, normalizedGroups.join('').length)
  return Math.round(options.length * Math.log(size) / Math.log(2))
}
