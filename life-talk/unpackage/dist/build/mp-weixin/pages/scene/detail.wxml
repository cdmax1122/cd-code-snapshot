<view class="data-v-bf825ed0"><block wx:if="{{scene}}"><view class="page data-v-bf825ed0" style="{{(pageStyle)}}"><view class="topbar data-v-bf825ed0" style="{{(topbarStyle)}}"><view class="topbar__back data-v-bf825ed0" hover-class="topbar__back--hover" data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" bindtap="__e">‹ 返回</view><text class="topbar__title data-v-bf825ed0">{{scene.name}}</text></view><view class="scene-banner data-v-bf825ed0"><text class="scene-banner__icon data-v-bf825ed0">{{scene.icon}}</text><view class="scene-banner__content data-v-bf825ed0"><text class="scene-banner__title data-v-bf825ed0">{{scene.name}}</text><text class="scene-banner__desc data-v-bf825ed0">{{scene.description}}</text></view></view><view class="panel data-v-bf825ed0"><view class="panel__head data-v-bf825ed0"><text class="panel__title data-v-bf825ed0">单词区</text><text class="panel__tag data-v-bf825ed0">{{$root.g0+" 个词汇"}}</text></view><view class="card-list data-v-bf825ed0"><block wx:for="{{scene.words}}" wx:for-item="item" wx:for-index="__i0__" wx:key="en"><view class="lang-card data-v-bf825ed0"><view class="lang-card__text data-v-bf825ed0"><text class="lang-card__en data-v-bf825ed0">{{item.en}}</text><text class="lang-card__zh data-v-bf825ed0">{{item.zh}}</text></view><view class="speak-btn data-v-bf825ed0" hover-class="speak-btn--hover" data-event-opts="{{[['tap',[['speak',['$0'],[[['scene.words','en',item.en,'en']]]]]]]}}" bindtap="__e"><text class="speak-btn__icon data-v-bf825ed0">🔊</text><text class="speak-btn__text data-v-bf825ed0">发音</text></view></view></block></view></view><view class="panel data-v-bf825ed0"><view class="panel__head data-v-bf825ed0"><text class="panel__title data-v-bf825ed0">短句区</text><text class="panel__tag data-v-bf825ed0">{{$root.g1+" 句表达"}}</text></view><view class="card-list data-v-bf825ed0"><block wx:for="{{scene.phrases}}" wx:for-item="item" wx:for-index="__i1__" wx:key="en"><view class="lang-card lang-card--phrase data-v-bf825ed0"><view class="lang-card__text data-v-bf825ed0"><text class="lang-card__en data-v-bf825ed0">{{item.en}}</text><text class="lang-card__zh data-v-bf825ed0">{{item.zh}}</text></view><view class="speak-btn data-v-bf825ed0" hover-class="speak-btn--hover" data-event-opts="{{[['tap',[['speak',['$0'],[[['scene.phrases','en',item.en,'en']]]]]]]}}" bindtap="__e"><text class="speak-btn__icon data-v-bf825ed0">🔊</text><text class="speak-btn__text data-v-bf825ed0">朗读</text></view></view></block></view></view></view></block><block wx:else><view class="empty data-v-bf825ed0"><text class="empty__title data-v-bf825ed0">未找到该场景</text><view class="empty__btn data-v-bf825ed0" hover-class="empty__btn--hover" data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" bindtap="__e">返回首页</view></view></block></view>